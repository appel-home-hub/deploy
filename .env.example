# Set these as environment variables on the Portainer stack.
# For a local `docker compose up`, copy this file to .env (which is git-ignored).

MQTT_HOST=mqtt://192.168.1.9:1883
TZ=America/Chicago

# weather (secret: set these in Portainer only, never commit real values)
OPENWEATHER_API_KEY=
LATITUDE=
LONGITUDE=

# firebase (secret: set in Portainer only)
FIREBASE_CONFIG_URL=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=

# ecobee (secret: set in Portainer only; the refresh token is only needed until
# the container has saved a newer one in its ecobee-data volume)
ECOBEE_API_KEY=
ECOBEE_REFRESH_TOKEN=

# broadlink
BROADLINK_CONFIG_URL=

# adb-remote
ADB_CONFIG_URL=

# radio-frequency (secret: set in Portainer only)
RF_COMMANDS_URL=
RF_SHOPVAC1=
RF_SHOPVAC2=
RF_XMASLIGHTS=
RF_OFFICELIGHTS=
RF_FIREPLACE=
RF_BACKDOOR1=
RF_BACKDOOR2=
RF_BASEMENTLIGHTS=
RF_SERVERLIGHT=
RF_WORKBENCHLIGHT=
RF_MOTORCYCLE=
