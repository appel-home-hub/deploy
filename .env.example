# Set these as environment variables on the Portainer stack.
# For a local `docker compose up`, copy this file to .env (which is git-ignored).

MQTT_HOST=mqtt://192.168.1.9:1883
TZ=America/Chicago

# weather (secret: set these in Portainer only, never commit real values)
OPENWEATHER_API_KEY=
LATITUDE=
LONGITUDE=
